# Keep development-only paths out of the distributed package.
# See docs/spec/quality-policy.md.
/.docker            export-ignore
/.husky             export-ignore
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/poc                export-ignore
/samples            export-ignore
/tests              export-ignore
/ARCHITECTURE.md    export-ignore
/docs               export-ignore
/CLAUDE.md          export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md    export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
/phpunit.xml        export-ignore
# Configuration for tools a consumer never runs. They were shipping.
/phpstan.neon       export-ignore
/pint.json          export-ignore
/composer-dependency-analyser.php export-ignore
